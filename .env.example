# ==========================================================
# HostelCare — Environment variables (template)
# ==========================================================
# Copy this file to `.env` and fill in your local values.
# NEVER commit a real `.env` to version control.

# Port the Express server will listen on
PORT=5000

# MySQL connection settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hostelcare

# Master activation key for first-time student account activation.
# All students use the same key in V1. Rotate by changing this value
# and re-deploying. Read by the backend via process.env.HOSTEL_ACTIVATION_KEY.
HOSTEL_ACTIVATION_KEY=replace-me-with-a-strong-key

# JWT signing secret used by /api/auth/login. Read by the backend
# via process.env.JWT_SECRET. MUST be a long random string in any
# non-development environment.
JWT_SECRET=replace-me-with-a-long-random-secret

# JWT lifetime. Accepts any string the `ms` library understands
# (e.g. '1h', '15m', '7d'). Read via process.env.JWT_EXPIRES_IN.
JWT_EXPIRES_IN=1h
